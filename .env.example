# ==============================================================================
# BiteFlow Environment Variables Reference (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite database path)
DATABASE_PATH=./database.db

# JWT Authentication Secret and Token Lifespan
JWT_SECRET=biteflow_super_secret_key_change_this_2026
JWT_EXPIRES_IN=7d

# Frontend URL & CORS Whitelist (Comma-separated origins)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:5000

# WebSocket / Socket.IO CORS Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173

# Optional: Google Maps Platform API Key for Real-time Geocoding and Live Map Tiles
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Mode: 'demo' (instant simulated payments) or 'live'
PAYMENT_MODE=demo

# UPI Payment Methods Toggle (Indian Swiggy/Zomato style UPI flow)
UPI_ENABLED=true
GPAY_ENABLED=true
PHONEPE_ENABLED=true
PAYTM_ENABLED=true

# Delivery Fee & Free Delivery Threshold (in INR ₹)
DEFAULT_DELIVERY_FEE=30
FREE_DELIVERY_MINIMUM=499
PLATFORM_FEE=5

# Order Boundaries (in INR ₹)
MINIMUM_ORDER_AMOUNT=100
MAXIMUM_ORDER_AMOUNT=10000

# Innovative Sustainability Settings
RESCUE_SURPLUS_DISCOUNT_PERCENT=50
GROUP_DELIVERY_DISCOUNT=30
